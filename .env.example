# Variables d'environnement de LogiFlow : copier ce fichier en .env (jamais
# versionné) et remplacer chaque valeur « a-remplacer ». Voir la section
# « Sécurité / variables obligatoires » du README.

# Base de données (obligatoire). Mot de passe sans caractère spécial d'URL
# (@ : / ? #), par exemple : openssl rand -hex 24
POSTGRES_DB=logiflow_db
POSTGRES_USER=logiflow_admin
POSTGRES_PASSWORD=a-remplacer
# Hors Docker uniquement (docker-compose.yml la construit à partir des valeurs ci-dessus)
DATABASE_URL=postgresql://logiflow_admin:a-remplacer@localhost:5432/logiflow_db

# Signature du cookie de session (obligatoire, 16 caractères au minimum) :
# openssl rand -hex 32
SESSION_SECRET=a-remplacer

# Chiffrement des secrets en base (mots de passe SMTP, jetons NocoDB), distinct
# de SESSION_SECRET : openssl rand -hex 32. Absente : repli sur SESSION_SECRET
# (avec avertissement). Les secrets chiffrés avec une ancienne clé (ancien
# SESSION_SECRET, valeurs publiées autrefois dans le dépôt, ou les clés de
# ENCRYPTION_KEY_PREVIOUS séparées par des virgules) sont rechiffrés
# automatiquement au démarrage.
ENCRYPTION_KEY=a-remplacer
ENCRYPTION_KEY_PREVIOUS=

# Mot de passe initial du compte « admin », utilisé seulement s'il n'existe pas
# encore. Vide : mot de passe aléatoire affiché une fois dans les journaux. Il
# doit être changé à la première connexion.
ADMIN_PASSWORD=

# Application
NODE_ENV=production
PORT=3000
USE_LOCAL_AUTH=true

# Route de secours POST /api/emergency-admin-reset : désactivée si vide.
# Ne définir qu'en cas de besoin, puis retirer.
EMERGENCY_SECRET=

# API externe de rapprochement BL / factures (docs/API-RAPPROCHEMENT.md).
# Les clés se créent de préférence dans Paramètres > API externe. Optionnel :
# une ou plusieurs clés supplémentaires ici, séparées par des virgules.
# Générer une clé : openssl rand -hex 32
EXTERNAL_API_KEYS=
